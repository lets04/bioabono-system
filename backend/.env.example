DATABASE_URL=postgresql://postgres:postgres@localhost:5432/bioabono
PORT=3000
FRONTEND_URL=http://localhost:5173

ADMIN_USERNAME=info@entropicaingenieria.com
ADMIN_PASSWORD=cambia-esta-clave
ADMIN_NAME=Administrador

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=BIOABONO <noreply@localhost>
SMTP_SECURE=false

ACTIVATION_TOKEN_TTL_HOURS=72
PASSWORD_RESET_TOKEN_TTL_HOURS=1
# Duración de una sesión normal; 5 min antes de vencer se ofrece mantenerla otras tantas horas
SESSION_MAX_HOURS=8
# Con "Mantener sesión iniciada": días sin uso tras los que vence (sobrevive a cerrar el navegador)
SESSION_REMEMBER_DAYS=30
BUSINESS_UTC_OFFSET=-04:00
# Solo si el frontend se sirve desde otro origen, p. ej. https://app.bioabono.com
# La cookie de sesión es SameSite=Strict: frontend y API deben compartir dominio base
# (app.bioabono.com + api.bioabono.com sirve; dominios distintos no envían la cookie).
CORS_ORIGINS=
# true solo detrás de un proxy (nginx, Cloudflare...) que fije X-Forwarded-For; si no, cualquiera puede falsear su IP.
# Ojo: detrás de un proxy con false, todos los clientes comparten la IP del proxy en el rate limit.
TRUST_PROXY=false
# Cookie de sesión solo por HTTPS. Por defecto true cuando NODE_ENV=production
COOKIE_SECURE=
